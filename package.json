{
  "name": "astra3d-experience",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "serve out -l tcp://127.0.0.1:4173 --no-clipboard",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
